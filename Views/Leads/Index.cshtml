@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Leads";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var assignedTo = ViewBag.AssignedTo as string;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    bool privileged = User.IsInRole("Admin") || User.IsInRole("Manager");
    var names = (Dictionary<string, string>)ViewBag.UserNames;
    var statuses = new[] { "New", "Contacted", "Qualified", "Unqualified", "Converted", "Lost" };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Leads</h3>
    <a asp-action="Create" class="btn btn-primary">+ New Lead</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Name, company, email ya phone" />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All Status</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(status == s)">@s</option>
            }
        </select>
    </div>
    @if (privileged)
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select">
                <option value="">All Users</option>
                @foreach (SelectListItem u in (SelectList)ViewBag.UserFilter)
                {
                    <option value="@u.Value" selected="@(assignedTo == u.Value)">@u.Text</option>
                }
            </select>
        </div>
    }
    <div class="col-md-3">
        <button type="submit" class="btn btn-dark">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Code</th><th>Name</th><th>Company</th><th>Phone</th><th>Source</th>
                <th>Value</th><th>Status</th><th>Assigned To</th><th style="width:210px">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var l in Model)
        {
            var cls = l.Status switch
            {
                "New" => "bg-primary",
                "Contacted" => "bg-info text-dark",
                "Qualified" => "bg-success",
                "Unqualified" => "bg-warning text-dark",
                "Converted" => "bg-dark",
                _ => "bg-secondary"
            };
            var owner = l.AssignedTo != null && names.TryGetValue(l.AssignedTo, out var n) ? n : "-";
            <tr>
                <td>@l.LeadCode</td>
                <td>@l.LeadName</td>
                <td>@l.CompanyName</td>
                <td>@l.Phone</td>
                <td>@l.Source</td>
                <td>@l.ExpectedValue.ToString("N2")</td>
                <td><span class="badge @cls">@l.Status</span></td>
                <td>@owner</td>
                <td>
                    <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-sm btn-outline-info">Details</a>
                    @if (l.Status != "Converted")
                    {
                        <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-sm btn-outline-primary">Edit</a>
                    }
                    @if (privileged && l.Status != "Converted")
                    {
                        <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" class="d-inline"
                              onsubmit="return confirm('Is lead ko delete karna hai?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center text-muted">Koi lead nahi mila.</td></tr>
        }
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination">
        <li class="page-item @(page <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)" asp-route-search="@search" asp-route-status="@status" asp-route-assignedTo="@assignedTo">Prev</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page @(page) of @(totalPages)</span></li>
        <li class="page-item @(page >= totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)" asp-route-search="@search" asp-route-status="@status" asp-route-assignedTo="@assignedTo">Next</a>
        </li>
    </ul>
</nav>

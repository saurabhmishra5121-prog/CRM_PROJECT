@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Lead Details"; }

<h3 class="mb-3">Lead Details</h3>
<dl class="row">
    <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.LeadCode</dd>
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.LeadName</dd>
    <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">Source</dt><dd class="col-sm-9">@Model.Source</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Expected Value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("N2")</dd>
    <dt class="col-sm-3">Assigned To</dt><dd class="col-sm-9">@((ViewBag.AssignedName as string) ?? "-")</dd>
    <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
</dl>

@if (Model.Status == "Qualified")
{
    <form asp-action="ConvertLead" asp-route-id="@Model.LeadId" method="post" class="d-inline"
          onsubmit="return confirm('Is lead ko Customer + Opportunity mein convert karna hai?');">
        <button type="submit" class="btn btn-success">Convert to Customer / Opportunity</button>
    </form>
}
@if (Model.Status != "Converted")
{
    <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary">Edit</a>
}
<a asp-action="Index" class="btn btn-outline-secondary">Back</a>

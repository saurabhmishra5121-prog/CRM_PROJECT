@model AcxiomCRM.ViewModels.LeadViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="LeadId" />

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="LeadName" class="form-label"></label>
        <input asp-for="LeadName" class="form-control" />
        <span asp-validation-for="LeadName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" maxlength="10" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Source" class="form-label"></label>
        <select asp-for="Source" asp-items="(SelectList)ViewBag.SourceOptions" class="form-select"></select>
        <span asp-validation-for="Source" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="(SelectList)ViewBag.StatusOptions" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="ExpectedValue" class="form-label"></label>
        <input asp-for="ExpectedValue" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="ExpectedValue" class="text-danger"></span>
    </div>
    @if ((bool)ViewBag.CanAssign)
    {
        <div class="col-md-6 mb-3">
            <label asp-for="AssignedTo" class="form-label"></label>
            <select asp-for="AssignedTo" asp-items="(SelectList)ViewBag.UserOptions" class="form-select"></select>
            <span asp-validation-for="AssignedTo" class="text-danger"></span>
        </div>
    }
</div>
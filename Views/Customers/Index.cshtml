@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customers";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    bool canDelete = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Customers</h3>
    <a asp-action="Create" class="btn btn-primary">+ New Customer</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Name, email, phone ya company search karo" />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All Status</option>
            <option value="Active" selected="@(status == "Active")">Active</option>
            <option value="Inactive" selected="@(status == "Inactive")">Inactive</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-dark">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Company</th>
                <th>City</th>
                <th>Status</th>
                <th style="width:210px">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CustomerCode</td>
                <td>@c.CustomerName</td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td>@c.CompanyName</td>
                <td>@c.City</td>
                <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-primary">Edit</a>
                    @if (canDelete)
                    {
                        <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline"
                              onsubmit="return confirm('Is customer ko delete karna hai?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="text-center text-muted">Koi customer nahi mila.</td></tr>
        }
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination">
        <li class="page-item @(page <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)" asp-route-search="@search" asp-route-status="@status">Prev</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page @(page) of @(totalPages)</span></li>
        <li class="page-item @(page >= totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)" asp-route-search="@search" asp-route-status="@status">Next</a>
        </li>
    </ul>
</nav>


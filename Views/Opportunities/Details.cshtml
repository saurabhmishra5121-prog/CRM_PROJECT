@model AcxiomCRM.Models.Opportunity
@{ ViewData["Title"] = "Opportunity Details"; }

<h3 class="mb-3">Opportunity Details</h3>
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.OpportunityName</dd>
    <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Customer?.CustomerCode - @Model.Customer?.CustomerName</dd>
    <dt class="col-sm-3">Stage</dt><dd class="col-sm-9">@Model.Stage</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">Rs. @Model.Amount.ToString("N2")</dd>
    <dt class="col-sm-3">Probability</dt><dd class="col-sm-9">@Model.Probability %</dd>
    <dt class="col-sm-3">Weighted Value</dt><dd class="col-sm-9">Rs. @((Model.Amount * Model.Probability / 100m).ToString("N2"))</dd>
    <dt class="col-sm-3">Expected Close</dt><dd class="col-sm-9">@Model.ExpectedCloseDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@((ViewBag.OwnerName as string) ?? "-")</dd>
    <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
    @if (Model.LeadId != null)
    {
        <dt class="col-sm-3">Source Lead</dt><dd class="col-sm-9">Converted from lead #@Model.LeadId</dd>
    }
</dl>
<a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back</a>
